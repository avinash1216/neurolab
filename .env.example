# Copy to .env (never commit .env). Locally: set these in your shell before `streamlit run`.

# Preferred: Gemini on Vertex AI (uses `gcloud auth application-default login` locally,
# or the Cloud Run service account in the cloud; no API key needed).
GOOGLE_CLOUD_PROJECT=gdw-user-avikumar
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Alternative: Gemini Developer API key (used only if GOOGLE_CLOUD_PROJECT is unset).
GEMINI_API_KEY=
